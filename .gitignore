.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Runtime outputs. Real exam material must not be committed by default.
*_BATCH_*/
data/xkw_cookies.json
data/*.log
*.db
data/raw/**
data/parsed/**
data/cleaned/**
data/reviewed/**
data/rejected/**
data/reports/**
data/state/**
logs/**

!data/raw/.gitkeep
!data/parsed/.gitkeep
!data/cleaned/.gitkeep
!data/reviewed/.gitkeep
!data/rejected/.gitkeep
!data/reports/.gitkeep
!data/state/.gitkeep
!logs/.gitkeep
